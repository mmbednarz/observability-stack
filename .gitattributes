# Skrypty PowerShell: CRLF. Pliki są w repo jako UTF-8 z BOM (polskie znaki w Windows PowerShell 5.1) - nie usuwaj BOM.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.sql   text eol=crlf

# Konfiguracje: LF
*.yml   text eol=lf
*.yaml  text eol=lf
*.alloy text eol=lf
*.ini   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Pliki wydania: LF
VERSION   text eol=lf
LICENSE   text eol=lf
*.txt     text eol=lf

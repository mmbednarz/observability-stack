# PowerShell scripts: CRLF. Files are stored as UTF-8 with BOM (non-ASCII characters in Windows PowerShell 5.1) - do not remove the BOM.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.sql   text eol=crlf

# Configuration files: LF
*.yml   text eol=lf
*.yaml  text eol=lf
*.alloy text eol=lf
*.ini   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Release files: LF
VERSION   text eol=lf
LICENSE   text eol=lf
*.txt     text eol=lf

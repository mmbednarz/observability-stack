    {
      "type": "stat",
      "id": 13,
      "title": "New failed emails (30 min)",
      "description": "Increase over the last 30 min in emails with at least 3 failed sending attempts (alert D2). Emails that ran out of attempts stay in the WFMails queue - their total is shown in the “Emails by attempt count” panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum(webcon_db_mails{attempts!~\"0|1|2\"}) - (sum(webcon_db_mails{attempts!~\"0|1|2\"} offset 30m) or sum(webcon_db_mails{attempts!~\"0|1|2\"})), 0)",
          "legendFormat": "emails",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {

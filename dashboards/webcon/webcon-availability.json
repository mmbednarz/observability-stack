          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (instance) ((probe_ssl_earliest_cert_expiry{job=\"integrations/blackbox\",instance=~\"$instance\"} - time()) / 86400)",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "range": true

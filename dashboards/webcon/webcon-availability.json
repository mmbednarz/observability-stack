    {
      "type": "table",
      "id": 18,
      "title": "Queue tables – now",
      "description": "Current row count of queue tables, descending.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 33,

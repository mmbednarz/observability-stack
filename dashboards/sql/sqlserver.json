    {
      "type": "timeseries",
      "title": "Batches and compilations /s",
      "id": 9,
      "description": "Compilations > 10% of batches = poor plan reuse (ad hoc queries, no parameterization).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 8,
        "x": 0,
        "h": 8,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mssql_batch_requests_total{job=\"integrations/mssql\"}[$__rate_interval]))",
          "legendFormat": "batches",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mssql_sql_compilations_total{job=\"integrations/mssql\"}[$__rate_interval]))",
          "legendFormat": "compilations",
          "refId": "B",
          "range": true

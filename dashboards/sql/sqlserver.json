  "templating": {
    "list": [
      {
        "name": "db",
        "label": "Databases",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(mssql_database_file_size_bytes{job=\"integrations/mssql\"}, db)",
          "refId": "db"
        },
        "definition": "label_values(mssql_database_file_size_bytes{job=\"integrations/mssql\"}, db)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": [

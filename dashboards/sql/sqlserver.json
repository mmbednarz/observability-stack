  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "x": 0,
        "h": 1,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Batches /s",
      "id": 2,
      "description": "Batch Requests/sec - general measure of SQL Server load.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 4,
        "x": 0,
        "h": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mssql_batch_requests_total{job=\"integrations/mssql\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "decimals": 1,
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ],
            "mode": "absolute"
          }
        }
      },
      "options": {
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "fields": "",
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "type": "stat",

        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mssql_sql_recompilations_total{job=\"integrations/mssql\"}[$__rate_interval]))",
          "legendFormat": "recompilations",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "spanNulls": true,
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line"
          },
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "table",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

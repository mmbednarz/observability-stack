          },
          "expr": "100 * sum(rate(mssql_signal_wait_time_seconds_total{job=\"integrations/mssql\"}[$__rate_interval])) / sum(rate(mssql_wait_time_seconds_total{job=\"integrations/mssql\"}[$__rate_interval]))",

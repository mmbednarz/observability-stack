    {
      "type": "stat",
      "title": "Page life expectancy",
      "id": 4,
      "description": "How long a page stays in the buffer pool. Drops / low values = memory pressure, more reads from disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 4,
        "x": 8,
        "h": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mssql_page_life_expectancy_seconds{job=\"integrations/mssql\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "decimals": 0,
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": -1
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "green",
                "value": 1000
              }
            ],
            "mode": "absolute"
          }
        }
      },
      "options": {
        "graphMode": "area",
